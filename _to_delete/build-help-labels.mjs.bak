#!/usr/bin/env node
/**
 * Builds the allowlist of fixed UI labels the Back Office guide may receive as screen context
 * ("People" panel, "Add person" button). Scans admin templates (.html and inline templates in .ts)
 * and literal label/title/header properties in admin .ts files.
 *
 * Anything written in source is product copy, not record data, so it is safe to send. Labels built
 * from data at runtime ("Remove " + name) never match a whole entry, so they are never sent.
 *
 * Output: libs/shared/src/lib/help-agent-labels.generated.ts (committed). Run: npm run help-labels
 * Stale output fails safe: a missing label just falls back to panel + icon context.
 */
import { readdirSync, readFileSync, statSync, writeFileSync } from 'node:fs';
import { join, relative, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';

const root = resolve(fileURLToPath(import.meta.url), '../..');
const srcDir = join(root, 'admin/src/app');
const outFile = join(root, 'libs/shared/src/lib/help-agent-labels.generated.ts');

// Keep in step with normalizeHelpLabel() in libs/shared/src/lib/help-agent.ts.
const normalize = (text) =>
  text
    .replace(/&nbsp;/g, ' ')
    .replace(/&amp;/g, '&')
    .replace(/&rarr;/g, '→')
    .replace(/&hellip;/g, '…')
    .replace(/\s+/g, ' ')
    .trim()
    .replace(/[\s:*…]+$/u, '')
    .toLowerCase();

const MAX_LEN = 80;
const labels = new Set();
const add = (raw) => {
  const text = normalize(raw);
  if (text.length < 2 || text.length > MAX_LEN || !/\p{L}/u.test(text)) return;
  labels.add(text);
};

/** Quoted string literals inside an Angular expression ({{ x ?? 'People' }}, [label]="'Save'"). */
const addLiterals = (expr) => {
  for (const m of expr.matchAll(/'((?:[^'\\]|\\.)*)'|"((?:[^"\\]|\\.)*)"/g)) add((m[1] ?? m[2]).replace(/\\'/g, "'"));
};

const STATIC_ATTRS = ['aria-label', 'title', 'pTooltip', 'label', 'header', 'placeholder', 'alt'];
const BOUND_ATTRS = ['attr.aria-label', 'title', 'pTooltip', 'label', 'header', 'attr.title'];

function scanTemplate(tpl) {
  for (const attr of STATIC_ATTRS) {
    for (const m of tpl.matchAll(new RegExp(`(?<![\\[\\w.-])${attr}="([^"]*)"`, 'g'))) {
      if (!m[1].includes('{{')) add(m[1]);
    }
  }
  for (const attr of BOUND_ATTRS) {
    const esc = attr.replace(/\./g, '\\.');
    for (const m of tpl.matchAll(new RegExp(`\\[${esc}\\]="([^"]*)"`, 'g'))) addLiterals(m[1]);
  }
  // Text nodes between tags.
  for (const m of tpl.matchAll(/>([^<>]+)</g)) {
    const text = m[1];
    if (/\{\{|@|[{}]/.test(text)) {
      for (const expr of text.matchAll(/\{\{([\s\S]*?)\}\}/g)) addLiterals(expr[1]);
      // Static text around interpolations/control flow, e.g. "People @if (...) {".
      for (const piece of text.split(/\{\{[\s\S]*?\}\}|@\w+[^{]*\{|[{}]/)) add(piece);
    } else {
      add(text);
    }
  }
}

function scanTs(source) {
  for (const m of source.matchAll(/template:\s*`([\s\S]*?)`\s*,\s*\n/g)) scanTemplate(m[1]);
  for (const m of source.matchAll(/\b(label|title|header|heading|tooltip)\s*:\s*'((?:[^'\\]|\\.)*)'/g)) add(m[2].replace(/\\'/g, "'"));
}

function walk(dir) {
  for (const name of readdirSync(dir)) {
    const path = join(dir, name);
    if (statSync(path).isDirectory()) walk(path);
    else if (name.endsWith('.html')) scanTemplate(readFileSync(path, 'utf8'));
    else if (name.endsWith('.ts') && !name.endsWith('.spec.ts')) scanTs(readFileSync(path, 'utf8'));
  }
}

walk(srcDir);
const sorted = [...labels].sort();
const body = [
  '// GENERATED by scripts/build-help-labels.mjs. Do not edit. Run: npm run help-labels',
  `// Fixed UI labels from ${relative(root, srcDir)} that the Back Office guide may receive as screen context.`,
  'export const HELP_AGENT_UI_LABELS: readonly string[] = [',
  ...sorted.map((l) => `  ${JSON.stringify(l)},`),
  '];',
  '',
].join('\n');
writeFileSync(outFile, body);
console.log(`help-labels: ${sorted.length} labels → ${relative(root, outFile)}`);
