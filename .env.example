DATABASE_URL="postgresql://ubo:ubo@localhost:5433/ubo?schema=public"
NODE_ENV="development"
PORT=3001

# SES (invoice email) — us-west-2; domain heyupstart.com must be verified in SES
# See docs/ses-setup.md. Empty AWS keys → "Email not configured" in the app.
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MAIL_FROM_EMAIL=hello@heyupstart.com
MAIL_FROM_NAME=UpStart Back Office

# Cognito — leave empty for dev email-only auth; set both to enable email/password locally
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=us-west-2
# Hosted UI domain prefix (Cognito console → App integration → Domain)
COGNITO_DOMAIN_PREFIX=
# Optional custom auth domain (e.g. auth.upstartproductions.com)
COGNITO_CUSTOM_DOMAIN=
# Must match Cognito app client callback/sign-out URLs for local dev
COGNITO_REDIRECT_SIGN_IN=http://localhost:4201/
COGNITO_REDIRECT_SIGN_OUT=http://localhost:4201/

CORS_ORIGINS=http://localhost:4201,http://localhost:4321
CORS_ALLOW_LOCAL_NETWORK=true

# Client portal (heyupstart.com magic links — no Cognito login)
# Local portal links: http://localhost:4321/clients
PORTAL_BASE_URL=http://localhost:4321/clients
PORTAL_SESSION_SECRET=
PORTAL_SESSION_MAX_AGE_DAYS=90
# Optional: set for cross-subdomain session cookies (api.heyupstart.com → heyupstart.com)
PORTAL_COOKIE_DOMAIN=

API_BASE_URL=http://localhost:3001/api

# File storage — local disk in dev (uploads/ served at /api/uploads/)
STORAGE_PROVIDER=local
# S3 (production): STORAGE_PROVIDER=s3, S3_BUCKET=upstart-back-office-files
