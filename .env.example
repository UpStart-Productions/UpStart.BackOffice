DATABASE_URL="postgresql://ubo:ubo@localhost:5433/ubo?schema=public"
NODE_ENV="development"
PORT=3001

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_key_id
AWS_SECRET_ACCESS_KEY=your_secret_key
MAIL_FROM_EMAIL=noreply@yourdomain.com
MAIL_FROM_NAME=UpStart Back Office

# Leave empty to disable Cognito (uses DevAuthGuard in dev)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=us-east-1

CORS_ORIGINS=http://localhost:4201
CORS_ALLOW_LOCAL_NETWORK=true

API_BASE_URL=http://localhost:3001/api
