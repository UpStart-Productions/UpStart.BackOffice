# Production .env for EC2 - copy to .env in repo root on the server.
# Do not commit .env to git.

# CORS — admin + public website (comma-separated, no trailing slashes)
# Must include heyupstart.com for the booking widget on the marketing site.
CORS_ORIGINS=https://office.heyupstart.com,https://heyupstart.com,https://www.heyupstart.com
CORS_ALLOW_LOCAL_NETWORK=false

# AWS credentials (shared by SES, Cognito SDK, and S3 — no separate S3 keys)
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
# All AWS services for this project use us-west-2
AWS_REGION=us-west-2

# Cognito
COGNITO_REGION=us-west-2
COGNITO_USER_POOL_ID=us-west-2_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# SES (email) — sender must be verified in SES
MAIL_FROM_EMAIL=hello@heyupstart.com
MAIL_FROM_NAME=UpStart Back Office

# Public API URL (used in email links; Amplify admin also uses this at build time)
API_BASE_URL=https://api.heyupstart.com/api

# File storage (S3)
STORAGE_PROVIDER=s3
S3_BUCKET=upstart-back-office-files
# Optional CloudFront or custom domain (no trailing slash)
# S3_PUBLIC_URL=https://files.heyupstart.com

# Client portal (magic links on heyupstart.com/clients?token=<token>)
PORTAL_BASE_URL=https://heyupstart.com/clients
PORTAL_SESSION_SECRET=generate-a-long-random-string
PORTAL_SESSION_MAX_AGE_DAYS=90
PORTAL_COOKIE_DOMAIN=.heyupstart.com

# --- Amplify Console (admin SPA build — match Nonprofit.Mobile.Platform) ---
# AMPLIFY_MONOREPO_APP_ROOT=admin
# AMPLIFY_DIFF_DEPLOY=false
# API_BASE_URL=https://api.heyupstart.com/api
# AMPLIFY_REDIRECT_SIGN_IN=https://office.heyupstart.com/
# AMPLIFY_REDIRECT_SIGN_OUT=https://office.heyupstart.com/
# AMPLIFY_COGNITO_CUSTOM_DOMAIN=auth.heyupstart.com
# COGNITO_USER_POOL_ID, COGNITO_CLIENT_ID, COGNITO_REGION, COGNITO_DOMAIN_PREFIX
