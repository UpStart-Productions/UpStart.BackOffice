# Production .env — copy to .env in repo root on the server.
# Do not commit .env to git.

# CORS — admin + any public sites that call the API (comma-separated, no trailing slashes)
# Include capacitor://localhost and ionic://localhost if a Capacitor mobile app uses this API.
CORS_ORIGINS=https://office.example.com,https://www.example.com,capacitor://localhost,ionic://localhost
# Set to true temporarily if you need to test a Capacitor app's live-reload mode
# (`ionic cap run ios -l --external`) against this server — live reload serves the
# app from your dev machine's LAN IP over HTTP (e.g. http://192.168.x.x:8100), which
# is a different Origin than capacitor://localhost and won't match CORS_ORIGINS no
# matter what's listed there. Bearer-token auth still applies either way, this only
# affects whether the browser/WKWebView is allowed to read the response. Leave false
# day-to-day; a real device/simulator build (no -l flag) uses capacitor://localhost
# and doesn't need this.
CORS_ALLOW_LOCAL_NETWORK=false

# AWS credentials (shared by SES, Cognito SDK, and S3)
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-west-2

# Cognito
COGNITO_REGION=us-west-2
COGNITO_USER_POOL_ID=us-west-2_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# SES — sender must be verified in SES
MAIL_FROM_EMAIL=hello@example.com
MAIL_FROM_NAME=UpStart Productions

# Public API URL (email links; Amplify admin build also uses this)
API_BASE_URL=https://api.example.com/api
ADMIN_BASE_URL=https://office.example.com

# File storage (S3)
STORAGE_PROVIDER=s3
S3_BUCKET=your-bucket-name
# Optional CloudFront or custom domain (no trailing slash)
# S3_PUBLIC_URL=https://files.example.com

# Client portal (magic links on your public site)
PORTAL_BASE_URL=https://www.example.com/clients
PORTAL_SESSION_SECRET=generate-a-long-random-string
PORTAL_SESSION_MAX_AGE_DAYS=90
PORTAL_COOKIE_DOMAIN=.example.com

# Stripe invoice payments — restricted live key + webhook signing secret
STRIPE_SECRET_KEY=rk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
PAY_BASE_URL=https://heyupstart.com/pay

# --- Amplify Console (admin SPA build) ---
# AMPLIFY_MONOREPO_APP_ROOT=admin
# AMPLIFY_DIFF_DEPLOY=false
# API_BASE_URL=https://api.example.com/api
# AMPLIFY_REDIRECT_SIGN_IN=https://office.example.com/
# AMPLIFY_REDIRECT_SIGN_OUT=https://office.example.com/
# AMPLIFY_COGNITO_CUSTOM_DOMAIN=auth.example.com
# COGNITO_USER_POOL_ID, COGNITO_CLIENT_ID, COGNITO_REGION, COGNITO_DOMAIN_PREFIX
