# Production .env for EC2 - copy to .env in repo root on the server.
# Do not commit .env to git.

# CORS — Amplify admin URL + any custom domain
CORS_ORIGINS=https://main.xxxxxxxx.amplifyapp.com,https://app.upstartproductions.com
CORS_ALLOW_LOCAL_NETWORK=false

# AWS credentials (shared by SES, Cognito SDK, and S3 — no separate S3 keys)
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
# All AWS services for this project use us-west-2
AWS_REGION=us-west-2

# Cognito
COGNITO_REGION=us-west-2
COGNITO_USER_POOL_ID=us-west-2_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# SES (email) — sender must be verified in SES
MAIL_FROM_EMAIL=hello@upstartproductions.com
MAIL_FROM_NAME=UpStart Back Office

# API base URL (used in email links)
API_BASE_URL=https://api.upstartproductions.com/api

# File storage (S3)
STORAGE_PROVIDER=s3
S3_BUCKET=upstart-back-office-files
# Optional CloudFront or custom domain (no trailing slash)
# S3_PUBLIC_URL=https://files.upstartproductions.com

# SNS push notifications (add when ready)
# SNS_PLATFORM_APPLICATION_ARN=arn:aws:sns:us-west-2:xxxxxxxxxxxx:app/APNS/...
# SNS_CUSTOMER_TOPIC_ARN_PATTERN=arn:aws:sns:us-west-2:xxxxxxxxxxxx:ubo-push-customer-{customerId}
