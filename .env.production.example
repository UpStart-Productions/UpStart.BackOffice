# Production .env for EC2 - copy to .env in repo root on the server.
# Do not commit .env to git.

# CORS — Amplify admin URL + any custom domain
CORS_ORIGINS=https://main.xxxxxxxx.amplifyapp.com,https://app.upstartproductions.com
CORS_ALLOW_LOCAL_NETWORK=false

# AWS (required for Cognito, SES; add S3/SNS when ready)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...

# Cognito
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# SES (email) — sender must be verified in SES
MAIL_FROM_EMAIL=hello@upstartproductions.com
MAIL_FROM_NAME=UpStart Back Office

# API base URL (used in email links)
API_BASE_URL=https://api.upstartproductions.com/api

# S3 (add when ready)
# STORAGE_PROVIDER=s3
# S3_BUCKET=ubo-files

# SNS push notifications (add when ready)
# SNS_PLATFORM_APPLICATION_ARN=arn:aws:sns:us-east-1:xxxxxxxxxxxx:app/APNS/...
# SNS_CUSTOMER_TOPIC_ARN_PATTERN=arn:aws:sns:us-east-1:xxxxxxxxxxxx:ubo-push-customer-{customerId}
