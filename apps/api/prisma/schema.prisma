/// Recurrence rule stored on Task.recurrence:
/// { freq: 'DAILY'|'WEEKLY'|'MONTHLY'|'YEARLY', interval: number, weekdays?: number[] (0=Sun),
///   mode: 'ON_COMPLETE'|'ON_SCHEDULE' }
/// When a recurring task is completed, the API creates the next instance.
model Task {
  id               String    @id @default(cuid())
  tenantId         String    @default("") // tenant scope; the empty default fails the FK, so a missed injection errors loudly
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  projectId        String
  sectionId        String?
  parentTaskId     String?
  name             String
  description      String?   @db.Text
  assigneeId       String?
  createdById      String?
  dueOn            DateTime? @db.Date
  dueAt            DateTime?
  isCompleted      Boolean   @default(false)
  completedAt      DateTime?
  completedById    String?
  sortOrder        Float     @default(0)
  recurrence       Json?
  /// The task this one was generated from when a recurring task completed.
  recurredFromId   String?
  importedAsanaGid String?   @unique
  /// Set when the task came in through a form.
  formId           String?
  submitterEmail   String?
  submitterName    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  form         TaskForm?              @relation(fields: [formId], references: [id], onDelete: SetNull)
  project      Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  section      TaskSection?           @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  parent       Task?                  @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks     Task[]                 @relation("TaskSubtasks")
  assignee     User?                  @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy    User?                  @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  completedBy  User?                  @relation("TaskCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  followers    TaskFollower[]
  comments     TaskComment[]
  attachments  TaskAttachment[]
  fieldValues  TaskCustomFieldValue[]
  timeEntries  TimeEntry[]
  /// Extra projects this task also appears in (Asana multi-homing). projectId stays the home project.
  projectLinks TaskProjectLink[]
  tags         TaskTag[]

  @@index([projectId, sectionId, sortOrder])
  @@index([parentTaskId, sortOrder])
  @@index([assigneeId, isCompleted, dueOn])
  @@index([tenantId])
}

model TaskFollower {
  tenantId  String   @default("") // tenant scope; the empty default fails the FK, so a missed injection errors loudly
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  taskId    String
  userId    String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
  @@index([tenantId])
}

