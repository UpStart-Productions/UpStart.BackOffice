  name      String
  type      AccountType
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  lines               JournalLine[]
  bankTransactions    BankTransaction[]
  categorizationRules CategorizationRule[]

  @@unique([tenantId, code])
  @@index([type])
}

/// A balanced set of debit/credit lines. Source of truth for all reporting —
/// P&L and Balance Sheet are computed by aggregating JournalLine, never stored.
model JournalEntry {
  id        String             @id @default(cuid())
  tenantId  String             @default("") // tenant scope; the empty default fails the FK, so a missed injection errors loudly
  tenant    Tenant             @relation(fields: [tenantId], references: [id])
  date      DateTime
  memo      String?
  source    JournalEntrySource @default(MANUAL)
  invoiceId String?
  createdAt DateTime           @default(now())

  invoice         Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  lines           JournalLine[]
  bankTransaction BankTransaction?

  @@index([date])
  @@index([invoiceId])
  @@index([source])
  @@index([tenantId])
}

model JournalLine {
  id             String  @id @default(cuid())
  tenantId       String  @default("") // tenant scope; the empty default fails the FK, so a missed injection errors loudly
  tenant         Tenant  @relation(fields: [tenantId], references: [id])
  journalEntryId String
  accountId      String
  debit          Decimal @default(0) @db.Decimal(12, 2)
  credit         Decimal @default(0) @db.Decimal(12, 2)

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
  @@index([tenantId])
}

/// Imported bank activity, held in an uncategorized queue until matched to an
/// Account and posted as a JournalEntry (source = BANK_IMPORT).
model BankTransaction {
  id             String   @id @default(cuid())
  tenantId       String   @default("") // tenant scope; the empty default fails the FK, so a missed injection errors loudly
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  importBatchId  String?
  date           DateTime
  description    String
  amount         Decimal  @db.Decimal(12, 2) // signed: positive = money in, negative = money out
  externalId     String? // dedupe key derived from the CSV row
  accountId      String? // categorized to this account once matched; null = uncategorized
  journalEntryId String?  @unique // set once posted to the ledger
  createdAt      DateTime @default(now())

  account      Account?      @relation(fields: [accountId], references: [id])
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@unique([tenantId, externalId])
  @@index([date])
  @@index([accountId])
  @@index([importBatchId])
}

/// Learned "this description -> this account" memory. Written automatically
/// every time a bank transaction is categorized (last choice wins — no
/// separate rules UI to manage). Read to pre-fill the category on future
/// imports whose description normalizes to the same key.
model CategorizationRule {
  id         String   @id @default(cuid())
  tenantId   String   @default("") // tenant scope; the empty default fails the FK, so a missed injection errors loudly
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  matchKey   String // normalized description: lowercased, digits/punctuation stripped
  accountId  String
  matchCount Int      @default(1)
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([tenantId, matchKey])
  @@index([accountId])
}

