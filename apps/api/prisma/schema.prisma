/// Chart of accounts. Deliberately flat — no parent/child hierarchy in v1.
model Account {
  id        String      @id @default(cuid())
  tenantId  String      @default("") // tenant scope; the empty default fails the FK, so a missed injection errors loudly
  tenant    Tenant      @relation(fields: [tenantId], references: [id])
