generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MEMBER
  CLIENT
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
}

enum LeadStage {
  NEW_LEAD
  DISCOVERY
  PROPOSAL_SENT
  ACTIVE_CLIENT
  PAST_CLIENT
  ON_HOLD
}

enum LeadSource {
  WARM_OUTREACH
  REFERRAL
  INBOUND
  EVENT
  SOCIAL
  COLD_OUTREACH
}

enum OrgCategory {
  RECOVERY
  FAMILY
  YOUTH
  FAITH
  HEALTH
  DISABILITY
  EDUCATION
  JOBS_WORKFORCE
  PETS
  FUNDING
  HUNGER
  VIOLENCE
  ACTIVITIES
  OTHER
}

enum ArtifactType {
  FILE
  LINK
  NOTE
}

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  firstName  String?
  lastName   String?
  name       String?
  avatarUrl  String?
  role       UserRole @default(MEMBER)
  hourlyRate Decimal? @db.Decimal(10, 2)
  isActive   Boolean  @default(true)
  clientId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  client      Client?      @relation(fields: [clientId], references: [id])
  timeEntries TimeEntry[]
}

model Client {
  id        String       @id @default(cuid())
  name      String
  code      String       @unique // e.g. "UPSP" — prepended to invoice numbers
  email     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  zip       String?
  website   String?
  notes     String?      @db.Text
  category  OrgCategory?
  isActive  Boolean      @default(true)
  portalEnabled       Boolean   @default(false)
  portalToken         String?   @unique
  portalTokenCreatedAt DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  projects   Project[]
  invoices   Invoice[]
  artifacts  Artifact[]
  users      User[]
  convertedFromLead Lead?
}

model Lead {
  id                String      @id @default(cuid())
  organization      String
  primaryContact    String?
  contactRole       String?
  email             String?
  phone             String?
  website           String?
  stage             LeadStage   @default(NEW_LEAD)
  source            LeadSource?
  warmConnection    String?
  category          OrgCategory?
  serviceInterests  String[]
  nextAction        String?     @db.Text
  nextActionDate    DateTime?
  lastContactDate   DateTime?
  convertedClientId String?     @unique
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  convertedClient Client?    @relation(fields: [convertedClientId], references: [id])
  artifacts       Artifact[]

  @@index([stage])
}

model Artifact {
  id        String       @id @default(cuid())
  leadId    String?
  clientId  String?
  projectId String?
  type      ArtifactType
  title     String

  // FILE
  fileUrl  String?
  fileSize Int?
  mimeType String?

  // LINK
  url      String?

  // NOTE (Quill delta JSON stored as text)
  content  String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead    Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  client  Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([clientId])
  @@index([projectId])
}

model Project {
  id          String   @id @default(cuid())
  clientId    String
  name        String
  description String?  @db.Text
  hourlyRate  Decimal? @db.Decimal(10, 2)
  isBillable  Boolean  @default(true)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client           Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tasks            ProjectTask[]
  timeEntries      TimeEntry[]
  invoiceLineItems InvoiceLineItem[]
  artifacts        Artifact[]

  @@index([clientId])
}

model ProjectTask {
  id         String   @id @default(cuid())
  projectId  String
  name       String
  isBillable Boolean  @default(true)
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  timeEntries TimeEntry[]

  @@unique([projectId, name])
  @@index([projectId])
}

model TimeEntry {
  id                String    @id @default(cuid())
  userId            String
  projectId         String
  projectTaskId     String?
  description       String?   @db.Text
  startedAt         DateTime
  stoppedAt         DateTime?
  durationMin       Int?
  isBillable        Boolean   @default(true)
  hourlyRate        Decimal?  @db.Decimal(10, 2)
  invoiceLineItemId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectTask     ProjectTask?     @relation(fields: [projectTaskId], references: [id], onDelete: SetNull)
  invoiceLineItem InvoiceLineItem? @relation(fields: [invoiceLineItemId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
  @@index([projectTaskId])
  @@index([invoiceLineItemId])
  @@index([startedAt])
}

model Invoice {
  id            String        @id @default(cuid())
  clientId      String
  number        Int           @unique
  displayNumber String
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime
  dueDate       DateTime?
  notes         String?       @db.Text
  subtotal      Decimal       @db.Decimal(10, 2)
  taxRate       Decimal?      @db.Decimal(5, 4)
  taxAmount     Decimal?      @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  sentAt        DateTime?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  client    Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lineItems InvoiceLineItem[]

  @@index([clientId])
  @@index([status])
}

model ServiceKey {
  id          String    @id @default(cuid())
  name        String    // human label, e.g. "Donor Readiness Audit"
  keyHash     String    @unique
  keyPrefix   String    // masked display, e.g. "ubo_abcd...wxyz"
  lastUsedAt  DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model InvoiceLineItem {
  id          String   @id @default(cuid())
  invoiceId   String
  projectId   String?
  description String
  quantity    Decimal  @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(10, 2)
  amount      Decimal  @db.Decimal(10, 2)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  invoice     Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  project     Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  timeEntries TimeEntry[]

  @@index([invoiceId])
  @@index([projectId])
}
