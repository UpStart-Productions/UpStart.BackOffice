generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MEMBER
  CLIENT
  /// External collaborator: sees only Task Manager projects they are a member of.
  GUEST
}

enum ProjectMemberRole {
  OWNER
  EDITOR
  COMMENTER
}

enum TaskCustomFieldType {
  TEXT
  NUMBER
  DATE
  SINGLE_SELECT
  MULTI_SELECT
  CHECKBOX
}

enum TaskCommentKind {
  COMMENT
  SYSTEM
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
}

enum PayableKind {
  INVOICE
}

enum PayableStatus {
  OPEN
  PAID
  CANCELED
}

enum LeadStage {
  NEW_LEAD
  DISCOVERY
  PROPOSAL_SENT
  ACTIVE_CLIENT
  PAST_CLIENT
  ON_HOLD
}

enum LeadSource {
  WARM_OUTREACH
  REFERRAL
  INBOUND
  EVENT
  SOCIAL
  COLD_OUTREACH
}

enum OrgCategory {
  RECOVERY
  FAMILY
  YOUTH
  FAITH
  HEALTH
  DISABILITY
  EDUCATION
  JOBS_WORKFORCE
  PETS
  FUNDING
  HUNGER
  VIOLENCE
  ACTIVITIES
  OTHER
}

enum ArtifactType {
  FILE
  LINK
  NOTE
}

enum ProjectTaskSource {
  MANUAL
  ASANA
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum JournalEntrySource {
  MANUAL
  INVOICE_ISSUED
  INVOICE_PAYMENT
  BANK_IMPORT
}

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  firstName  String?
  lastName   String?
  name       String?
  avatarUrl  String?
  role       UserRole @default(MEMBER)
  hourlyRate Decimal? @db.Decimal(10, 2)
  isActive   Boolean  @default(true)
  clientId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  client           Client?       @relation(fields: [clientId], references: [id])
  timeEntries      TimeEntry[]
  expenses         Expense[]
  bookingTypesHost BookingType[] @relation("BookingTypeHost")

  projectMemberships  ProjectMember[]
  projectStars        ProjectStar[]
  tasksAssigned       Task[]                     @relation("TaskAssignee")
  tasksCreated        Task[]                     @relation("TaskCreatedBy")
  tasksCompleted      Task[]                     @relation("TaskCompletedBy")
  taskFollows         TaskFollower[]
  taskComments        TaskComment[]
  taskAttachments     TaskAttachment[]
  notifications       UserNotification[]
  notificationPref    UserNotificationPreference?
  invites             UserInvite[]               @relation("InviteFor")
  invitesSent         UserInvite[]               @relation("InviteSentBy")
}

model Client {
  id                   String       @id @default(cuid())
  name                 String
  code                 String       @unique // e.g. "UPSP" — prepended to invoice numbers
  email                String?
  phone                String?
  address              String?
  city                 String?
  state                String?
  zip                  String?
  website              String?
  notes                String?      @db.Text
  category             OrgCategory?
  isActive             Boolean      @default(true)
  portalEnabled        Boolean      @default(false)
  portalToken          String?      @unique
  portalTokenCreatedAt DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  projects          Project[]
  invoices          Invoice[]
  artifacts         Artifact[]
  users             User[]
  convertedFromLead Lead?
}

model Lead {
  id                String       @id @default(cuid())
  organization      String
  primaryContact    String?
  contactRole       String?
  email             String?
  phone             String?
  website           String?
  stage             LeadStage    @default(NEW_LEAD)
  source            LeadSource?
  warmConnection    String?
  category          OrgCategory?
  serviceInterests  String[]
  nextAction        String?      @db.Text
  nextActionDate    DateTime?
  lastContactDate   DateTime?
  convertedClientId String?      @unique
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  convertedClient Client?    @relation(fields: [convertedClientId], references: [id])
  artifacts       Artifact[]
  bookings        Booking[]

  @@index([stage])
}

model NetworkCompany {
  id               String        @id @default(cuid())
  name             String
  website          String?
  email            String?
  phone            String?
  description      String?       @db.Text
  services         String[]
  products         String[]
  focusCategories  OrgCategory[]
  notes            String?       @db.Text
  isActive         Boolean       @default(true)
  isReferralReady  Boolean       @default(false)
  isPublicFeatured Boolean       @default(false)
  publicSortOrder  Int           @default(0)
  lastContactDate  DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  contacts  NetworkContact[]
  artifacts Artifact[]

  @@index([name])
  @@index([isReferralReady])
  @@index([isPublicFeatured])
}

model NetworkContact {
  id              String    @id @default(cuid())
  companyId       String
  firstName       String
  lastName        String?
  title           String?
  email           String?
  phone           String?
  linkedInUrl     String?
  avatarUrl       String?
  isPrimary       Boolean   @default(false)
  lastContactDate DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company   NetworkCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  artifacts Artifact[]

  @@index([companyId])
  @@index([email])
}

model Artifact {
  id               String       @id @default(cuid())
  leadId           String?
  clientId         String?
  projectId        String?
  networkCompanyId String?
  networkContactId String?
  type             ArtifactType
  title            String

  // FILE
  fileUrl  String?
  fileSize Int?
  mimeType String?

  // LINK
  url String?

  // NOTE (Quill delta JSON stored as text)
  content String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead           Lead?           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  client         Client?         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project        Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  networkCompany NetworkCompany? @relation(fields: [networkCompanyId], references: [id], onDelete: Cascade)
  networkContact NetworkContact? @relation(fields: [networkContactId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([clientId])
  @@index([projectId])
  @@index([networkCompanyId])
  @@index([networkContactId])
}

model Project {
  id               String   @id @default(cuid())
  /// Optional: personal / internal projects have no client.
  clientId         String?
  name             String
  description      String?  @db.Text
  hourlyRate       Decimal? @db.Decimal(10, 2)
  isBillable       Boolean  @default(true)
  isActive         Boolean  @default(true)
  asanaProjectGid  String?
  asanaProjectGids Json?
  asanaProjectName String?
  asanaSectionGid  String?
  asanaSectionGids Json?
  asanaSectionName String?
  /// Task Manager display color (hex) and source Asana project for imports.
  color            String?
  /// Added to the Task Manager (Tasks). Projects are created/edited on the Projects page.
  inTaskManager    Boolean  @default(false)
  importedAsanaGid String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  client           Client?           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contacts         ProjectContact[]
  tasks            ProjectTask[]
  timeEntries      TimeEntry[]
  expenses         Expense[]
  invoiceLineItems InvoiceLineItem[]
  artifacts        Artifact[]

  members          ProjectMember[]
  stars            ProjectStar[]
  sections         TaskSection[]
  workTasks        Task[]
  customFields     TaskCustomField[]

  @@index([clientId])
}

model ProjectContact {
  id        String   @id @default(cuid())
  projectId String
  firstName String?
  lastName  String?
  phone     String?
  email     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectTask {
  id           String            @id @default(cuid())
  projectId    String
  name         String
  source       ProjectTaskSource @default(MANUAL)
  asanaTaskGid String?
  isBillable   Boolean           @default(true)
  sortOrder    Int               @default(0)
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  timeEntries TimeEntry[]

  @@unique([projectId, asanaTaskGid])
  @@index([projectId])
  @@index([projectId, source])
}

model AsanaIntegration {
  id                         String    @id @default("default")
  clientId                   String?
  clientSecretEnc            String?
  redirectUri                String?
  accessTokenEnc             String?
  refreshTokenEnc            String?
  tokenExpiresAt             DateTime?
  workspaceGid               String?
  workspaceName              String?
  connectedByEmail           String?
  pendingOAuthState          String?
  pendingOAuthStateExpiresAt DateTime?
  connectedAt                DateTime?
  updatedAt                  DateTime  @updatedAt
}

model GoogleCalendarIntegration {
  id                         String    @id @default("default")
  clientId                   String?
  clientSecretEnc            String?
  redirectUri                String?
  accessTokenEnc             String?
  refreshTokenEnc            String?
  tokenExpiresAt             DateTime?
  calendarId                 String?
  calendarSummary            String?
  connectedByEmail           String?
  pendingOAuthState          String?
  pendingOAuthStateExpiresAt DateTime?
  connectedAt                DateTime?
  updatedAt                  DateTime  @updatedAt
}

model OrganizationProfile {
  id        String   @id @default("default")
  address   String?
  city      String?
  state     String?
  zip       String?
  phone     String?
  updatedAt DateTime @updatedAt
}

model TimeEntry {
  id                String    @id @default(cuid())
  userId            String
  projectId         String
  projectTaskId     String?
  /// Optional link to a Task Manager task.
  taskId            String?
  description       String?   @db.Text
  startedAt         DateTime
  stoppedAt         DateTime?
  durationMin       Int?
  isBillable        Boolean   @default(true)
  hourlyRate        Decimal?  @db.Decimal(10, 2)
  invoiceLineItemId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectTask     ProjectTask?     @relation(fields: [projectTaskId], references: [id], onDelete: SetNull)
  task            Task?            @relation(fields: [taskId], references: [id], onDelete: SetNull)
  invoiceLineItem InvoiceLineItem? @relation(fields: [invoiceLineItemId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
  @@index([projectTaskId])
  @@index([taskId])
  @@index([invoiceLineItemId])
  @@index([startedAt])
}

/// A logged business expense — reimbursable, billable to a client project, or
/// just recorded for the books. Deliberately separate from the Accounting
/// module for now: no journal entry is posted automatically. No approval
/// workflow either — submitted expenses are final immediately (deletable by
/// staff/admin), unlike Invoice's draft state.
model Expense {
  id             String   @id @default(cuid())
  userId         String
  projectId      String?
  description    String
  amount         Decimal  @db.Decimal(10, 2)
  category       String?
  incurredAt     DateTime
  isReimbursable Boolean  @default(false)
  isBillable     Boolean  @default(false)
  paymentMethod  String?
  receiptUrl     String?
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
  @@index([incurredAt])
}

model Invoice {
  id            String        @id @default(cuid())
  clientId      String
  number        Int           @unique
  displayNumber String
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime
  dueDate       DateTime?
  notes         String?       @db.Text
  subtotal      Decimal       @db.Decimal(10, 2)
  taxRate       Decimal?      @db.Decimal(5, 4)
  taxAmount     Decimal?      @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  sentAt        DateTime?
  paidAt        DateTime?
  amountPaid    Decimal?      @db.Decimal(10, 2)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  client         Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lineItems      InvoiceLineItem[]
  journalEntries JournalEntry[]
  payable        Payable?

  @@index([clientId])
  @@index([status])
}

model Payable {
  id                      String        @id @default(cuid())
  token                   String        @unique
  kind                    PayableKind
  status                  PayableStatus @default(OPEN)
  title                   String
  amount                  Decimal       @db.Decimal(10, 2)
  currency                String        @default("usd")
  invoiceId               String?       @unique
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  stripeReceiptNumber     String?
  stripeReceiptUrl        String?
  receiptEmailedAt        DateTime?
  paidAt                  DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([kind, status])
}

model ServiceKey {
  id         String    @id @default(cuid())
  name       String // human label, e.g. "Donor Readiness Audit"
  keyHash    String    @unique
  keyPrefix  String // masked display, e.g. "ubo_abcd...wxyz"
  lastUsedAt DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model InvoiceLineItem {
  id          String   @id @default(cuid())
  invoiceId   String
  projectId   String?
  description String
  quantity    Decimal  @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(10, 2)
  amount      Decimal  @db.Decimal(10, 2)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  invoice     Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  project     Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  timeEntries TimeEntry[]

  @@index([invoiceId])
  @@index([projectId])
}

model BookingType {
  id                 String     @id @default(cuid())
  slug               String     @unique
  name               String
  brand              String?
  isActive           Boolean    @default(true)
  hostUserId         String
  durationMin        Int        @default(30)
  bufferMin          Int        @default(0)
  minNoticeHours     Int        @default(4)
  maxDaysAhead       Int        @default(60)
  timezone           String     @default("America/Los_Angeles")
  publicPageUrl      String
  calendarEventTitle String     @default("Meeting")
  createLead         Boolean    @default(true)
  leadStage          LeadStage  @default(DISCOVERY)
  leadSource         LeadSource @default(INBOUND)
  pipelineNoteTitle  String?
  priceCents         Int?
  currency           String     @default("USD")
  isBillable         Boolean    @default(false)
  paymentRequired    Boolean    @default(false)
  sortOrder          Int        @default(0)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  host              User                      @relation("BookingTypeHost", fields: [hostUserId], references: [id])
  availabilityRules BookingAvailabilityRule[]
  bookings          Booking[]

  @@index([isActive])
  @@index([sortOrder])
}

model BookingAvailabilityRule {
  id            String @id @default(cuid())
  bookingTypeId String
  dayOfWeek     Int
  startMinute   Int
  endMinute     Int

  bookingType BookingType @relation(fields: [bookingTypeId], references: [id], onDelete: Cascade)

  @@index([bookingTypeId])
}

model Booking {
  id            String        @id @default(cuid())
  bookingTypeId String
  startAt       DateTime
  endAt         DateTime
  status        BookingStatus @default(CONFIRMED)
  guestName     String
  guestEmail    String
  guestOrg      String?
  guestMessage  String?       @db.Text
  guestTimezone String?
  cancelToken   String        @unique @default(cuid())
  leadId        String?
  googleEventId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  bookingType BookingType @relation(fields: [bookingTypeId], references: [id])
  lead        Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([startAt])
  @@index([status])
  @@index([guestEmail])
  @@index([bookingTypeId])
}

/// Chart of accounts. Deliberately flat — no parent/child hierarchy in v1.
model Account {
  id        String      @id @default(cuid())
  code      String      @unique // e.g. "1000" — simple numeric COA, sorted for display
  name      String
  type      AccountType
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  lines               JournalLine[]
  bankTransactions    BankTransaction[]
  categorizationRules CategorizationRule[]

  @@index([type])
}

/// A balanced set of debit/credit lines. Source of truth for all reporting —
/// P&L and Balance Sheet are computed by aggregating JournalLine, never stored.
model JournalEntry {
  id        String             @id @default(cuid())
  date      DateTime
  memo      String?
  source    JournalEntrySource @default(MANUAL)
  invoiceId String?
  createdAt DateTime           @default(now())

  invoice         Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  lines           JournalLine[]
  bankTransaction BankTransaction?

  @@index([date])
  @@index([invoiceId])
  @@index([source])
}

model JournalLine {
  id             String  @id @default(cuid())
  journalEntryId String
  accountId      String
  debit          Decimal @default(0) @db.Decimal(12, 2)
  credit         Decimal @default(0) @db.Decimal(12, 2)

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
}

/// Imported bank activity, held in an uncategorized queue until matched to an
/// Account and posted as a JournalEntry (source = BANK_IMPORT).
model BankTransaction {
  id             String   @id @default(cuid())
  importBatchId  String?
  date           DateTime
  description    String
  amount         Decimal  @db.Decimal(12, 2) // signed: positive = money in, negative = money out
  externalId     String?  @unique // dedupe key derived from the CSV row
  accountId      String? // categorized to this account once matched; null = uncategorized
  journalEntryId String?  @unique // set once posted to the ledger
  createdAt      DateTime @default(now())

  account      Account?      @relation(fields: [accountId], references: [id])
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([accountId])
  @@index([importBatchId])
}

/// Learned "this description -> this account" memory. Written automatically
/// every time a bank transaction is categorized (last choice wins — no
/// separate rules UI to manage). Read to pre-fill the category on future
/// imports whose description normalizes to the same key.
model CategorizationRule {
  id         String   @id @default(cuid())
  matchKey   String   @unique // normalized description: lowercased, digits/punctuation stripped
  accountId  String
  matchCount Int      @default(1)
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Task Manager
// ProjectTask (above) remains the billing/timesheet category list. Task is the
// full Asana-style work item. TimeEntry can reference either.
// ─────────────────────────────────────────────────────────────────────────────

model ProjectMember {
  id        String            @id @default(cuid())
  projectId String
  userId    String
  role      ProjectMemberRole @default(EDITOR)
  createdAt DateTime          @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model ProjectStar {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  sortOrder Float    @default(0)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model TaskSection {
  id               String   @id @default(cuid())
  projectId        String
  name             String
  sortOrder        Float    @default(0)
  isCollapsed      Boolean  @default(false)
  importedAsanaGid String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId, sortOrder])
}

/// Recurrence rule stored on Task.recurrence:
/// { freq: 'DAILY'|'WEEKLY'|'MONTHLY'|'YEARLY', interval: number, weekdays?: number[] (0=Sun),
///   mode: 'ON_COMPLETE'|'ON_SCHEDULE' }
/// When a recurring task is completed, the API creates the next instance.
model Task {
  id               String    @id @default(cuid())
  projectId        String
  sectionId        String?
  parentTaskId     String?
  name             String
  description      String?   @db.Text
  assigneeId       String?
  createdById      String?
  dueOn            DateTime? @db.Date
  dueAt            DateTime?
  isCompleted      Boolean   @default(false)
  completedAt      DateTime?
  completedById    String?
  sortOrder        Float     @default(0)
  recurrence       Json?
  /// The task this one was generated from when a recurring task completed.
  recurredFromId   String?
  importedAsanaGid String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  project      Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  section      TaskSection?           @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  parent       Task?                  @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks     Task[]                 @relation("TaskSubtasks")
  assignee     User?                  @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy    User?                  @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  completedBy  User?                  @relation("TaskCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  followers    TaskFollower[]
  comments     TaskComment[]
  attachments  TaskAttachment[]
  fieldValues  TaskCustomFieldValue[]
  timeEntries  TimeEntry[]

  @@index([projectId, sectionId, sortOrder])
  @@index([parentTaskId, sortOrder])
  @@index([assigneeId, isCompleted, dueOn])
}

model TaskFollower {
  taskId    String
  userId    String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

/// Task comments (Quill HTML with mention spans) and system activity lines.
model TaskComment {
  id               String          @id @default(cuid())
  taskId           String
  authorId         String?
  /// Display name snapshot; used for imported Asana stories whose author isn't a user here.
  authorLabel      String?
  kind             TaskCommentKind @default(COMMENT)
  body             String          @db.Text
  editedAt         DateTime?
  importedAsanaGid String?         @unique
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  task   Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
}

model TaskAttachment {
  id               String   @id @default(cuid())
  taskId           String
  uploadedById     String?
  fileName         String
  /// Storage key (FILE) — null for external links.
  fileUrl          String?
  /// External URL (LINK, e.g. imported Asana attachments hosted elsewhere).
  url              String?
  fileSize         Int?
  mimeType         String?
  importedAsanaGid String?  @unique
  createdAt        DateTime @default(now())

  task       Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([taskId])
}

/// Per-project custom field. options (select types): [{ id, label, color }]
model TaskCustomField {
  id               String              @id @default(cuid())
  projectId        String
  name             String
  type             TaskCustomFieldType
  options          Json?
  sortOrder        Float               @default(0)
  importedAsanaGid String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  project Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  values  TaskCustomFieldValue[]

  @@unique([projectId, importedAsanaGid])
  @@index([projectId, sortOrder])
}

/// value: string | number | boolean | ISO date | optionId | optionId[]
model TaskCustomFieldValue {
  taskId    String
  fieldId   String
  value     Json
  updatedAt DateTime @updatedAt

  task  Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  field TaskCustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@id([taskId, fieldId])
  @@index([fieldId])
}

// ─────────────────────────────────────────────────────────────────────────────
// In-app notifications (ported from KC.SPP.WebApp, minus organizations)
// ─────────────────────────────────────────────────────────────────────────────

model UserNotification {
  id        String    @id @default(cuid())
  userId    String
  /// e.g. task_assigned, task_mention, task_comment, task_completed
  type      String
  title     String
  body      String?
  /// { entityType, entityId, route: string[], actorUserId, actorLabel, projectId }
  meta      Json?
  readAt    DateTime?
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deletedAt, createdAt])
  @@index([userId, deletedAt, readAt])
}

model UserNotificationPreference {
  userId           String   @id
  /// { task_assigned: bool, task_mention: bool, task_comment: bool, ... } — missing keys default on.
  emailPreferences Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Email invitation for someone shared on a Task Manager project. The link lets them set a
/// password (Cognito) and sign in. Only the SHA-256 of the token is stored.
model UserInvite {
  id          String    @id @default(cuid())
  userId      String
  invitedById String?
  projectId   String?
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  user      User  @relation("InviteFor", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User? @relation("InviteSentBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([userId])
}
