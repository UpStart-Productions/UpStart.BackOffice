enum TaskFormAccess {
  /// Anyone with the link (email required).
  OPEN
  /// Signed-in collaborators on the form's project.
  COLLABORATORS
  /// Server-to-server: requests carry the form's API key.
  API_KEY
}

/// Intake form that creates tasks in a project.
model TaskForm {
  id                  String         @id @default(cuid())
  tenantId            String         @default("") // tenant scope; the empty default fails the FK, so a missed injection errors loudly
  tenant              Tenant         @relation(fields: [tenantId], references: [id])
  projectId           String
  name                String
  /// URL key: /f/:slug and POST /forms/:slug/submit
  slug                String         @unique
  description         String?        @db.Text
  access              TaskFormAccess @default(COLLABORATORS)
  isActive            Boolean        @default(true)
  /// Where new tasks land; null = project's first section.
  sectionId           String?
  assigneeId          String?
  /// Tag ids applied to every submission.
  tagIds              Json?
  /// FormQuestion[] (see task-forms.util.ts)
  questions           Json
  confirmationMessage String?        @db.Text
  apiKeyHash          String?        @unique
  apiKeyHint          String?
  createdById         String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  section   TaskSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  assignee  User?        @relation("TaskFormAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User?        @relation("TaskFormCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  tasks     Task[]

  @@index([projectId])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// CRM & communications (see docs/crm-communications-spec.md)
// Phase 1: `Tenant` is a stub with a single "default" row. Every new table
// carries tenantId from day one; existing tables get it in phase 2.
// "Account" in the spec == the existing Client table, so FKs here say clientId.
// ---------------------------------------------------------------------------

enum InteractionType {
  EMAIL
  CALL
  MEETING
  NOTE
}

enum InteractionDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum InteractionSource {
  FORWARD
  BCC
  /// Capture address visible in To/Cc (deliberate CC, kept on reply-all).
  CC
  CALENDAR
  MANUAL
}

enum InteractionStatus {
  FILED
  UNFILED
}

enum ParticipantRole {
  FROM
  TO
  CC
  BCC
  ATTENDEE
}

model Tenant {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  /// Email domains that count as this tenant's own team (besides staff users), e.g. thepurplenest.org.
  internalDomains String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  contacts       Contact[]
  contactEmails  ContactEmail[]
  interactions   Interaction[]
  inboundAliases InboundAlias[]

  // Back-relations: every tenant-scoped model.
  users                       User[]
  clients                     Client[]
  leads                       Lead[]
  networkCompanys             NetworkCompany[]
  networkContacts             NetworkContact[]
  artifacts                   Artifact[]
  projects                    Project[]
  projectContacts             ProjectContact[]
  projectTasks                ProjectTask[]
  asanaIntegrations           AsanaIntegration[]
  googleCalendarIntegrations  GoogleCalendarIntegration[]
  organizationProfiles        OrganizationProfile[]
  timeEntrys                  TimeEntry[]
  expenses                    Expense[]
  invoices                    Invoice[]
  payables                    Payable[]
  serviceKeys                 ServiceKey[]
  invoiceLineItems            InvoiceLineItem[]
  bookingTypes                BookingType[]
  bookingAvailabilityRules    BookingAvailabilityRule[]
  bookings                    Booking[]
  accounts                    Account[]
  journalEntrys               JournalEntry[]
  journalLines                JournalLine[]
  bankTransactions            BankTransaction[]
  categorizationRules         CategorizationRule[]
  projectMembers              ProjectMember[]
  projectStars                ProjectStar[]
  taskSections                TaskSection[]
  taskProjectLinks            TaskProjectLink[]
  tags                        Tag[]
  taskTags                    TaskTag[]
  clientTags                  ClientTag[]
  contactTags                 ContactTag[]
  tasks                       Task[]
  taskFollowers               TaskFollower[]
  taskComments                TaskComment[]
  taskAttachments             TaskAttachment[]
  taskCustomFields            TaskCustomField[]
  taskCustomFieldValues       TaskCustomFieldValue[]
  userNotifications           UserNotification[]
  userNotificationPreferences UserNotificationPreference[]
  userInvites                 UserInvite[]
  taskForms                   TaskForm[]
  contactAccounts             ContactAccount[]
  interactionParticipants     InteractionParticipant[]
  interactionCaptures         InteractionCapture[]
  forwardingVerifications     ForwardingVerification[]
  roles                       Role[]
  clientAssignments           ClientAssignment[]
  pipelines                   Pipeline[]
  pipelineStages              PipelineStage[]
}

/// A person. Peer of Client/Lead; never the owner of projects, invoices or time.
model Contact {
  id            String    @id @default(cuid())
  tenantId      String    @default("")
  firstName     String
  lastName      String?
  title         String?
  phone         String?
  avatarUrl     String?
  linkedInUrl   String?
  notes         String?   @db.Text
  isActive      Boolean   @default(true)
  /// True when created from an inbound email and not yet reviewed.
  autoCreated   Boolean   @default(false)
  lastContactAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant          Tenant                   @relation(fields: [tenantId], references: [id])
  emails          ContactEmail[]
  accountLinks    ContactAccount[]
  participants    InteractionParticipant[]
  leads           Lead[]
  tags            ContactTag[]
  projectContacts ProjectContact[]

  @@index([tenantId, lastName, firstName])
}

model ContactEmail {
  id        String   @id @default(cuid())
  tenantId  String   @default("")
  contactId String
  /// Stored lowercased.
  email     String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([contactId])
}

/// Many-to-many between people and accounts (Client rows), with a role.
model ContactAccount {
  id        String   @id @default(cuid())
  tenantId  String   @default("") // tenant scope; the empty default fails the FK, so a missed injection errors loudly
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  contactId String
  clientId  String
  /// e.g. family member, POA, case manager, employee
  role      String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([contactId, clientId])
  @@index([clientId])
  @@index([tenantId])
}

/// One entry on a client/lead communication timeline.
model Interaction {
  id             String               @id @default(cuid())
  tenantId       String               @default("")
  type           InteractionType
  direction      InteractionDirection @default(INBOUND)
  occurredAt     DateTime
  subject        String?
  /// Where a meeting took place: a room, an address, or a link.
  location       String?
  bodyText       String?              @db.Text
  /// Storage keys for sanitized HTML and the raw MIME message.
  bodyHtmlKey    String?
  rawKey         String?
  /// RFC 5322 Message-ID; dedupes the same email forwarded by several people.
  messageId      String?
  threadKey      String?
  source         InteractionSource
  status         InteractionStatus    @default(UNFILED)
  clientId       String?
  leadId         String?
  loggedByUserId String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  tenant       Tenant                   @relation(fields: [tenantId], references: [id])
  client       Client?                  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  lead         Lead?                    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  loggedBy     User?                    @relation("InteractionLoggedBy", fields: [loggedByUserId], references: [id], onDelete: SetNull)
  participants InteractionParticipant[]
  captures     InteractionCapture[]
  artifacts    Artifact[]

  @@unique([tenantId, messageId])
  @@index([tenantId, clientId, occurredAt])
  @@index([tenantId, status, occurredAt])
  @@index([tenantId, threadKey])
  @@index([leadId])
}

model InteractionParticipant {
  id            String          @id @default(cuid())
  tenantId      String          @default("") // tenant scope; the empty default fails the FK, so a missed injection errors loudly
  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  interactionId String
  contactId     String?
  userId        String?
  email         String
  name          String?
  role          ParticipantRole

  interaction Interaction @relation(fields: [interactionId], references: [id], onDelete: Cascade)
  contact     Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([interactionId])
  @@index([contactId])
  @@index([email])
  @@index([tenantId])
}

/// Who forwarded/BCC'd a message. A second forward of the same Message-ID adds a row here, not a new Interaction.
model InteractionCapture {
  id              String   @id @default(cuid())
  tenantId        String   @default("") // tenant scope; the empty default fails the FK, so a missed injection errors loudly
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  interactionId   String
  userId          String?
  capturedByEmail String
  capturedAt      DateTime @default(now())

  interaction Interaction @relation(fields: [interactionId], references: [id], onDelete: Cascade)
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([interactionId, capturedByEmail])
  @@index([tenantId])
}

/// Per-tenant inbound address local-part (e.g. "tpn" for tpn@in.<domain>). Old aliases keep routing.
model InboundAlias {
  id        String   @id @default(cuid())
  tenantId  String   @default("")
  alias     String   @unique
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant        Tenant                   @relation(fields: [tenantId], references: [id])
  verifications ForwardingVerification[]

  @@index([tenantId])
}

/// Gmail's forwarding-confirmation message, surfaced in Settings so the user can finish setting up a filter.
model ForwardingVerification {
  id           String   @id @default(cuid())
  tenantId     String   @default("") // tenant scope; the empty default fails the FK, so a missed injection errors loudly
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  aliasId      String
  /// The Gmail address asking to forward to us.
  gmailAddress String?
  code         String?
  link         String?  @db.Text
  receivedAt   DateTime @default(now())

  alias InboundAlias @relation(fields: [aliasId], references: [id], onDelete: Cascade)

  @@index([aliasId, receivedAt])
  @@index([tenantId])
}

/// Platform-wide Help Agent (in-app guide). Single row id "default" at the app layer.
enum AiProvider {
  ANTHROPIC
  OPENAI
  GEMINI
}

model HelpAgentSettings {
  id              String     @id
  provider        AiProvider @default(ANTHROPIC)
  model           String
  encryptedApiKey String
  keyLastFour     String
  updatedByUserId String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  updatedByUser User? @relation("HelpAgentSettingsUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
}

/// Emailed password-reset codes. Global (not per tenant): the login is one per email. Only a hash of
/// the code is stored; a code expires, can be tried a limited number of times, and works once.
model PasswordReset {
  id        String    @id @default(cuid())
  email     String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
}
