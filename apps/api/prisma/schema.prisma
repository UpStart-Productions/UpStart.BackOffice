generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// ADMIN can do everything. USER can do what their tenant Role grants. CLIENT is a client portal login (never the back office).
enum UserRole {
  ADMIN
  USER
  CLIENT
}

enum ProjectMemberRole {
  OWNER
  EDITOR
  COMMENTER
}

enum TaskCustomFieldType {
  TEXT
  NUMBER
  DATE
  SINGLE_SELECT
  MULTI_SELECT
  CHECKBOX
}

enum TaskCommentKind {
  COMMENT
  SYSTEM
}

/// Who the invoice is addressed to. CLIENT: the tenant billing a client (revenue). TENANT: a user billing the tenant (a bill the tenant owes).
enum InvoiceBillTo {
  CLIENT
  TENANT
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
}

enum PayableKind {
  INVOICE
}

enum PayableStatus {
  OPEN
  PAID
  CANCELED
}

enum AccountJourney {
  PROSPECT
  CLIENT
  /// Not in a sales journey (partners, referral sources, vendors). Tags say what they are.
  NONE
}

enum LeadStage {
  NEW_LEAD
  DISCOVERY
  PROPOSAL_SENT
  ON_HOLD
}

enum LeadSource {
  WARM_OUTREACH
  REFERRAL
  INBOUND
  EVENT
  SOCIAL
  COLD_OUTREACH
}

enum OrgCategory {
  RECOVERY
  FAMILY
  YOUTH
  FAITH
  HEALTH
  DISABILITY
  EDUCATION
  JOBS_WORKFORCE
  PETS
  FUNDING
  HUNGER
  VIOLENCE
  ACTIVITIES
  OTHER
}

enum ArtifactType {
  FILE
  LINK
  NOTE
}

enum ProjectTaskSource {
  MANUAL
  ASANA
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum JournalEntrySource {
  MANUAL
  INVOICE_ISSUED
  INVOICE_PAYMENT
  BANK_IMPORT
}

/// Staff user assigned to a client (e.g. a care manager on a family). With Clients at level "own",
/// a user only reaches clients they are assigned to.
model ClientAssignment {
  id        String   @id @default(cuid())
  tenantId  String   @default("") // tenant scope; the empty default fails the FK, so a missed injection errors loudly
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("ClientAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([clientId, userId])
  @@index([tenantId])
  @@index([userId])
}

/// Tenant-defined role for staff users: a name plus the app areas it can use, each at level own or all.
/// Admins are not a Role: User.role = ADMIN can do everything.
model Role {
  id          String   @id @default(cuid())
  tenantId    String   @default("") // tenant scope; the empty default fails the FK, so a missed injection errors loudly
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  /// Built-in role marker, e.g. "guest" (given to people invited to a Task Manager project). Null for roles admins create.
  key         String?
  /// Area -> level, e.g. { "time": "own", "clients": "all" }. Missing area = no access. See libs/shared permissions.ts.
  permissions Json     @default("{}")
  /// Area -> { create, edit, delete, setup } checkboxes, e.g. { "pipeline": { "delete": false } }. Missing = allowed.
  actions     Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@unique([tenantId, name])
  @@unique([tenantId, key])
  @@index([tenantId])
}

model User {
  id         String   @id @default(cuid())
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
  /// Platform operator: can switch between tenants. Regular users belong to exactly one tenant.
  isSuper    Boolean  @default(false)
  /// One row per person per tenant (the row is their membership: role, rate, active flag). The same
  /// email may have rows in several tenants; sign-in is one Cognito login per email. Platform
  /// operators (tenantId null) are kept unique by a partial index in the migration.
  email      String
  firstName  String?
  lastName   String?
  name       String?
  avatarUrl  String?
  role       UserRole @default(USER)
  /// For USER accounts: the tenant role that decides which areas they can use. Null for admins, who can do everything.
  roleId     String?
  tenantRole Role?    @relation(fields: [roleId], references: [id])
  hourlyRate Decimal? @db.Decimal(10, 2)
  isActive   Boolean  @default(true)
  clientId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  client           Client?       @relation(fields: [clientId], references: [id])
  timeEntries      TimeEntry[]
  expenses         Expense[]
  bookingTypesHost BookingType[] @relation("BookingTypeHost")

  projectMemberships        ProjectMember[]
  projectStars              ProjectStar[]
  tasksAssigned             Task[]                      @relation("TaskAssignee")
  assignedTaskForms         TaskForm[]                  @relation("TaskFormAssignee")
  createdTaskForms          TaskForm[]                  @relation("TaskFormCreatedBy")
  tasksCreated              Task[]                      @relation("TaskCreatedBy")
  tasksCompleted            Task[]                      @relation("TaskCompletedBy")
  taskFollows               TaskFollower[]
  taskComments              TaskComment[]
  taskAttachments           TaskAttachment[]
  notifications             UserNotification[]
  notificationPref          UserNotificationPreference?
  invites                   UserInvite[]                @relation("InviteFor")
  invitesSent               UserInvite[]                @relation("InviteSentBy")
  interactionsLogged        Interaction[]               @relation("InteractionLoggedBy")
  interactionCaptures       InteractionCapture[]
  interactionParticipations InteractionParticipant[]
  invoicesCreated           Invoice[]                   @relation("InvoiceCreatedBy")
  clientAssignments         ClientAssignment[]          @relation("ClientAssignmentUser")
  helpAgentSettingsUpdates  HelpAgentSettings[]         @relation("HelpAgentSettingsUpdatedBy")

  @@unique([tenantId, email])
  @@index([email])
  @@index([tenantId])
  @@index([roleId])
}

model Client {
  id                   String         @id @default(cuid())
  tenantId             String         @default("") // tenant scope; the empty default fails the FK, so a missed injection errors loudly
  tenant               Tenant         @relation(fields: [tenantId], references: [id])
  name                 String
  code                 String? // e.g. "UPSP" — prepended to invoice numbers; required once billing starts
  /// Where the account is in the relationship. Manual and reversible; not tied to pipeline stage.
  journey              AccountJourney @default(CLIENT)
  // Network-derived fields (folded in from NetworkCompany). Kept until we confirm what, if anything, reads them.
  services             String[]       @default([])
  products             String[]       @default([])
  focusCategories      OrgCategory[]  @default([])
  isReferralReady      Boolean        @default(false)
  isPublicFeatured     Boolean        @default(false)
  publicSortOrder      Int            @default(0)
  lastContactAt        DateTime?
  email                String?
  phone                String?
  address              String?
  city                 String?
  state                String?
  zip                  String?
  website              String?
  notes                String?        @db.Text
  category             OrgCategory?
  isActive             Boolean        @default(true)
  portalEnabled        Boolean        @default(false)
  portalToken          String?        @unique
  portalTokenCreatedAt DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  projects          Project[]
  invoices          Invoice[]
  timeEntries       TimeEntry[]
  artifacts         Artifact[]
  users             User[]
  convertedFromLead Lead?              @relation("LeadConverted")
  leads             Lead[]             @relation("LeadAccount")
  contactLinks      ContactAccount[]
  interactions      Interaction[]
  assignments       ClientAssignment[]
  tags              ClientTag[]

  @@unique([tenantId, code])
}

model Lead {
  id                String       @id @default(cuid())
  tenantId          String       @default("") // tenant scope; the empty default fails the FK, so a missed injection errors loudly
  tenant            Tenant       @relation(fields: [tenantId], references: [id])
  organization      String
  primaryContact    String?
  contactRole       String?
  email             String?
  phone             String?
  website           String?
  stage             LeadStage    @default(NEW_LEAD)
  source            LeadSource?
  warmConnection    String?
  category          OrgCategory?
  serviceInterests  String[]
  nextAction        String?      @db.Text
  nextActionDate    DateTime?
  lastContactDate   DateTime?
  convertedClientId String?      @unique
  /// The Account this pipeline item belongs to. Every lead has one (a Prospect until you make it a client).
  clientId          String?
  /// The lead's person. Source of truth for name, email and phone; the text columns above are a legacy mirror.
  primaryContactId  String?
  /// The tenant-defined pipeline and lane this card sits in. `stage` above is a legacy mirror.
  pipelineId        String?
  stageId           String?
  /// Set when someone archives the card by hand: off the board, history kept, restorable.
  archivedAt        DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  convertedClient Client?        @relation("LeadConverted", fields: [convertedClientId], references: [id])
  client          Client?        @relation("LeadAccount", fields: [clientId], references: [id])
  contact         Contact?       @relation(fields: [primaryContactId], references: [id], onDelete: SetNull)
  pipeline        Pipeline?      @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  pipelineStage   PipelineStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  artifacts       Artifact[]
  bookings        Booking[]
  interactions    Interaction[]

  @@index([stage])
  @@index([pipelineId, stageId])
  @@index([clientId])
  @@index([primaryContactId])
  @@index([tenantId])
}

/// A relationship pipeline. Each tenant defines its own pipelines and lanes; there are no won/lost stages.
model Pipeline {
  id        String   @id @default(cuid())
  tenantId  String   @default("") // tenant scope; the empty default fails the FK, so a missed injection errors loudly
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stages PipelineStage[]
  leads  Lead[]

  @@index([tenantId, sortOrder])
}

/// A lane (swim lane) on a pipeline board. Just a name, a color and a position.
model PipelineStage {
  id         String     @id @default(cuid())
  tenantId   String     @default("") // tenant scope; the empty default fails the FK, so a missed injection errors loudly
  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  pipelineId String
  pipeline   Pipeline   @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name       String
  color      String?
  sortOrder  Int        @default(0)
  /// The old fixed stage this lane came from, kept so older automations keep working. Null for new lanes.
  legacyKey  LeadStage?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  leads        Lead[]
  bookingTypes BookingType[]

  @@index([pipelineId, sortOrder])
  @@index([tenantId])
}

model NetworkCompany {
  id               String        @id @default(cuid())
  tenantId         String        @default("") // tenant scope; the empty default fails the FK, so a missed injection errors loudly
  tenant           Tenant        @relation(fields: [tenantId], references: [id])
  name             String
  website          String?
  email            String?
  phone            String?
  description      String?       @db.Text
  services         String[]
  products         String[]
  focusCategories  OrgCategory[]
  notes            String?       @db.Text
  isActive         Boolean       @default(true)
  isReferralReady  Boolean       @default(false)
  isPublicFeatured Boolean       @default(false)
  publicSortOrder  Int           @default(0)
  lastContactDate  DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  contacts  NetworkContact[]
  artifacts Artifact[]

  @@index([name])
  @@index([isReferralReady])
  @@index([isPublicFeatured])
  @@index([tenantId])
}

model NetworkContact {
  id              String    @id @default(cuid())
  tenantId        String    @default("") // tenant scope; the empty default fails the FK, so a missed injection errors loudly
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  companyId       String
  firstName       String
  lastName        String?
  title           String?
  email           String?
  phone           String?
  linkedInUrl     String?
  avatarUrl       String?
  isPrimary       Boolean   @default(false)
  lastContactDate DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company   NetworkCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  artifacts Artifact[]

  @@index([companyId])
  @@index([email])
  @@index([tenantId])
}

model Artifact {
  id               String       @id @default(cuid())
  tenantId         String       @default("") // tenant scope; the empty default fails the FK, so a missed injection errors loudly
  tenant           Tenant       @relation(fields: [tenantId], references: [id])
  leadId           String?
  clientId         String?
  projectId        String?
  networkCompanyId String?
  networkContactId String?
  interactionId    String?
  type             ArtifactType
  title            String

  // FILE
  fileUrl  String?
  fileSize Int?
  mimeType String?

  // LINK
  url String?

  // NOTE (Quill delta JSON stored as text)
  content String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead           Lead?           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  client         Client?         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project        Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  networkCompany NetworkCompany? @relation(fields: [networkCompanyId], references: [id], onDelete: Cascade)
  networkContact NetworkContact? @relation(fields: [networkContactId], references: [id], onDelete: Cascade)
  interaction    Interaction?    @relation(fields: [interactionId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([clientId])
  @@index([projectId])
  @@index([networkCompanyId])
  @@index([networkContactId])
  @@index([interactionId])
  @@index([tenantId])
}

model Project {
  id               String   @id @default(cuid())
  tenantId         String   @default("") // tenant scope; the empty default fails the FK, so a missed injection errors loudly
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  /// Optional: personal / internal projects have no client.
  clientId         String?
  name             String
  description      String?  @db.Text
  hourlyRate       Decimal? @db.Decimal(10, 2)
  isBillable       Boolean  @default(true)
  isActive         Boolean  @default(true)
  asanaProjectGid  String?
  asanaProjectGids Json?
  asanaProjectName String?
  asanaSectionGid  String?
  asanaSectionGids Json?
  asanaSectionName String?
  /// Task Manager display color (hex) and source Asana project for imports.
  color            String?
  /// Task Manager icon: a Lucide icon name (kebab-case), e.g. "house".
  icon             String?
  /// Added to the Task Manager (Tasks). Projects are created/edited on the Projects page.
  inTaskManager    Boolean  @default(false)
  importedAsanaGid String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  client           Client?           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contacts         ProjectContact[]
  tasks            ProjectTask[]
  timeEntries      TimeEntry[]
  expenses         Expense[]
  invoiceLineItems InvoiceLineItem[]
  artifacts        Artifact[]

  members      ProjectMember[]
  stars        ProjectStar[]
  sections     TaskSection[]
  workTasks    Task[]
  taskLinks    TaskProjectLink[]
  taskForms    TaskForm[]
  customFields TaskCustomField[]

  @@index([clientId])
  @@index([tenantId])
}

model ProjectContact {
  id        String   @id @default(cuid())
  tenantId  String   @default("") // tenant scope; the empty default fails the FK, so a missed injection errors loudly
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  projectId String
  firstName String?
  lastName  String?
  phone     String?
  email     String?
  avatarUrl String?
  contactId String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([tenantId])
  @@index([contactId])
}

model ProjectTask {
  id           String            @id @default(cuid())
  tenantId     String            @default("") // tenant scope; the empty default fails the FK, so a missed injection errors loudly
  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  projectId    String
  name         String
  source       ProjectTaskSource @default(MANUAL)
  asanaTaskGid String?
  isBillable   Boolean           @default(true)
  sortOrder    Int               @default(0)
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  timeEntries TimeEntry[]

  @@unique([projectId, asanaTaskGid])
  @@index([projectId])
  @@index([projectId, source])
  @@index([tenantId])
}

model AsanaIntegration {
  id                         String    @id @default(cuid())
  tenantId                   String    @unique @default("") // tenant scope; the empty default fails the FK, so a missed injection errors loudly
  tenant                     Tenant    @relation(fields: [tenantId], references: [id])
  clientId                   String?
  clientSecretEnc            String?
  redirectUri                String?
  accessTokenEnc             String?
  refreshTokenEnc            String?
  tokenExpiresAt             DateTime?
  workspaceGid               String?
  workspaceName              String?
  connectedByEmail           String?
  pendingOAuthState          String?
  pendingOAuthStateExpiresAt DateTime?
  connectedAt                DateTime?
  updatedAt                  DateTime  @updatedAt
}

model GoogleCalendarIntegration {
  id                         String    @id @default(cuid())
  tenantId                   String    @unique @default("") // tenant scope; the empty default fails the FK, so a missed injection errors loudly
  tenant                     Tenant    @relation(fields: [tenantId], references: [id])
  clientId                   String?
  clientSecretEnc            String?
  redirectUri                String?
  accessTokenEnc             String?
  refreshTokenEnc            String?
  tokenExpiresAt             DateTime?
  calendarId                 String?
  calendarSummary            String?
  connectedByEmail           String?
  pendingOAuthState          String?
  pendingOAuthStateExpiresAt DateTime?
  connectedAt                DateTime?
  updatedAt                  DateTime  @updatedAt
}

model OrganizationProfile {
  id           String   @id @default(cuid())
  tenantId     String   @unique @default("") // tenant scope; the empty default fails the FK, so a missed injection errors loudly
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  companyName  String?
  logoUrl      String?
  address      String?
  city         String?
  state        String?
  zip          String?
  phone        String?
  /// Where invoices billed to the tenant are sent by default.
  billingEmail String?
  /// Reimbursement rate per mile for Mileage expenses.
  mileageRate  Decimal? @db.Decimal(10, 4)
  updatedAt    DateTime @updatedAt
}

model TimeEntry {
  id                      String    @id @default(cuid())
  tenantId                String    @default("") // tenant scope; the empty default fails the FK, so a missed injection errors loudly
  tenant                  Tenant    @relation(fields: [tenantId], references: [id])
  userId                  String
  /// Optional: time can be logged without a project (e.g. a caregiver's shift).
  projectId               String?
  /// The client this time is for: the project's client when there is a project, else picked directly. Optional.
  clientId                String?
  projectTaskId           String?
  /// Optional link to a Task Manager task.
  taskId                  String?
  description             String?   @db.Text
  startedAt               DateTime
  stoppedAt               DateTime?
  durationMin             Int?
  isBillable              Boolean   @default(true)
  hourlyRate              Decimal?  @db.Decimal(10, 2)
  /// Line on an invoice billed to a client.
  invoiceLineItemId       String?
  /// Line on the user's own invoice to the tenant. Separate from invoiceLineItemId so the same time can be billed to the client and paid to the user.
  tenantInvoiceLineItemId String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  project               Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client                Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectTask           ProjectTask?     @relation(fields: [projectTaskId], references: [id], onDelete: SetNull)
  task                  Task?            @relation(fields: [taskId], references: [id], onDelete: SetNull)
  invoiceLineItem       InvoiceLineItem? @relation("ClientInvoiceTime", fields: [invoiceLineItemId], references: [id], onDelete: SetNull)
  tenantInvoiceLineItem InvoiceLineItem? @relation("TenantInvoiceTime", fields: [tenantInvoiceLineItemId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
  @@index([clientId])
  @@index([projectTaskId])
  @@index([taskId])
  @@index([invoiceLineItemId])
  @@index([tenantInvoiceLineItemId])
  @@index([startedAt])
  @@index([tenantId])
}

/// A logged business expense — reimbursable, billable to a client project, or
/// just recorded for the books. Deliberately separate from the Accounting
/// module for now: no journal entry is posted automatically. No approval
/// workflow either — submitted expenses are final immediately (deletable by
/// staff/admin), unlike Invoice's draft state.
model Expense {
  id                      String   @id @default(cuid())
  tenantId                String   @default("") // tenant scope; the empty default fails the FK, so a missed injection errors loudly
  tenant                  Tenant   @relation(fields: [tenantId], references: [id])
  userId                  String
  projectId               String?
  description             String
  amount                  Decimal  @db.Decimal(10, 2)
  category                String?
  incurredAt              DateTime
  isReimbursable          Boolean  @default(false)
  isBillable              Boolean  @default(false)
  paymentMethod           String?
  receiptUrl              String?
  notes                   String?  @db.Text
  /// Mileage expenses: miles driven and the rate per mile used (amount = miles x rate).
  miles                   Decimal? @db.Decimal(10, 2)
  mileageRate             Decimal? @db.Decimal(10, 4)
  /// Line on the user's own invoice to the tenant (reimbursement).
  tenantInvoiceLineItemId String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  project               Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  tenantInvoiceLineItem InvoiceLineItem? @relation("TenantInvoiceExpense", fields: [tenantInvoiceLineItemId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
  @@index([tenantInvoiceLineItemId])
  @@index([incurredAt])
  @@index([tenantId])
}

model Invoice {
  id            String        @id @default(cuid())
  tenantId      String        @default("") // tenant scope; the empty default fails the FK, so a missed injection errors loudly
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  billTo        InvoiceBillTo @default(CLIENT)
  /// Set when billTo = CLIENT; null when billing the tenant.
  clientId      String?
  /// Bill-to snapshot printed on the invoice and used to send it. Filled from the client or the tenant, editable.
  billToName    String?
  billToEmail   String?
  billToAddress String?       @db.Text
  /// Who created it; null for invoices that predate this. Used by roles limited to their own invoices.
  createdById   String?
  createdBy     User?         @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  number        Int
  displayNumber String
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime
  dueDate       DateTime?
  notes         String?       @db.Text
  subtotal      Decimal       @db.Decimal(10, 2)
  taxRate       Decimal?      @db.Decimal(5, 4)
  taxAmount     Decimal?      @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  sentAt        DateTime?
  paidAt        DateTime?
  amountPaid    Decimal?      @db.Decimal(10, 2)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  client         Client?           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lineItems      InvoiceLineItem[]
  journalEntries JournalEntry[]
  payable        Payable?

  @@unique([tenantId, number])
  @@index([clientId])
  @@index([createdById])
  @@index([status])
}

model Payable {
  id                      String        @id @default(cuid())
  tenantId                String        @default("") // tenant scope; the empty default fails the FK, so a missed injection errors loudly
  tenant                  Tenant        @relation(fields: [tenantId], references: [id])
  token                   String        @unique
  kind                    PayableKind
  status                  PayableStatus @default(OPEN)
  title                   String
  amount                  Decimal       @db.Decimal(10, 2)
  currency                String        @default("usd")
  invoiceId               String?       @unique
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  stripeReceiptNumber     String?
  stripeReceiptUrl        String?
  receiptEmailedAt        DateTime?
  paidAt                  DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

