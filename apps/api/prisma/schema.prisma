/// What a tag is for. Task tags and CRM tags (organizations and people) are separate lists.
enum TagScope {
  TASK
  CRM
}

/// Tenant tags. TASK tags are shared across all task projects; CRM tags label organizations and
/// people (Partner, Vendor, Referral source...).
model Tag {
  id               String   @id @default(cuid())
  tenantId         String   @default("") // tenant scope; the empty default fails the FK, so a missed injection errors loudly
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  name             String
  /// Lowercased name for case-insensitive uniqueness.
  nameKey          String
  color            String?
  importedAsanaGid String?  @unique
  scope            TagScope @default(TASK)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tasks    TaskTag[]
  clients  ClientTag[]
  contacts ContactTag[]

  @@unique([tenantId, scope, nameKey])
}

